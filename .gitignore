*.retry
*.tar.gz
.ansible/
.venv/
.env
.vault-password
artifacts/
context/
__pycache__/

# Secret DATA must never be committed. Do not ignore files merely because
# their *name* contains "secret"; task files, credential schemas and safe
# variable mappings legitimately use that word.
**/vault.yml
**/vault.yaml
**/*.secrets.local.yml
**/*.secrets.local.yaml
**/*.secret.local.yml
**/*.secret.local.yaml

# Local AWX bootstrap secret inputs. The example/schema files remain tracked.
awx/bootstrap-secrets.yml

# Third-party Galaxy content is installed for local/controller tooling or
# baked into the Execution Environment, not committed to Git.
collections/ansible_collections/*
!collections/ansible_collections/nima/
collections/ansible_collections/nima/*
!collections/ansible_collections/nima/platform/
!collections/ansible_collections/nima/platform/**

# Vendored EE collection artifacts are fetched/built locally or restored from
# an internal artifact store before the EE build. Keep the directory/docs only.
collections/vendor/*.tar.gz
