!collections/ansible_collections/nima/
collections/ansible_collections/nima/*
!collections/ansible_collections/nima/platform/
!collections/ansible_collections/nima/platform/**

# Local encrypted AWX bootstrap secret inputs.
awx/bootstrap-secrets.yml
